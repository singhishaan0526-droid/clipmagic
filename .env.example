# =============================================================================
# Clip Magic Environment Configuration Template
# COPY this file to .env and set your secrets. DO NOT commit .env to source control!
# =============================================================================

# Server Port (default: 8000)
PORT=8000

# Environment Mode: 'development' or 'production' (enables HTTPS redirect & HSTS in production)
NODE_ENV=development

# Google Gemini AI API Key (required for AI auto-transcription and subtitles)
# Obtain from Google AI Studio: https://aistudio.google.com/
# CRITICAL SECURITY NOTE: Never commit real keys. Keep server-side only.
# If an API key was ever accidentally committed in git history, rotate it immediately.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Privacy-preserving analytics identifier (e.g., Plausible domain or site ID)
# Non-essential telemetry is loaded only after explicit user cookie consent.
ANALYTICS_ID=
