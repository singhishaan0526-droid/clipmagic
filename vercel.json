{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/editor", "destination": "/frontend/editor.html" },
    { "source": "/upload", "destination": "/frontend/upload.html" },
    { "source": "/dashboard", "destination": "/frontend/dashboard.html" },
    { "source": "/about", "destination": "/frontend/about.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
